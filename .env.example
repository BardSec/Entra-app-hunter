# ─────────────────────────────────────────────────────────────────────────────
# Entra App Auditor — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# Set to "true" to use built-in mock data (no real Entra tenant required).
# Set to "false" to connect to a real Microsoft Entra ID tenant.
MOCK_MODE=true

# Auth mode when MOCK_MODE=false:
#   "app"       — App-only auth via client credentials (no user login required).
#                 Requires CLIENT_SECRET below. Best for automated/admin tooling.
#   "delegated" — Delegated auth. Backend accepts a Bearer token obtained by the
#                 frontend via MSAL.js. No CLIENT_SECRET needed on the backend.
AUTH_MODE=app

# Microsoft Entra ID tenant details (required when MOCK_MODE=false)
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here   # Only required when AUTH_MODE=app

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Vite) settings — these are baked in at build time
# ─────────────────────────────────────────────────────────────────────────────

# Must match AUTH_MODE above. "mock" disables all frontend auth UI.
VITE_AUTH_MODE=mock   # mock | app | delegated

# Required when VITE_AUTH_MODE=delegated
VITE_CLIENT_ID=your-client-id-here
VITE_TENANT_ID=your-tenant-id-here

# Port the backend Flask server listens on (default: 5000)
BACKEND_PORT=5000

# Backend URL used by the Vite dev proxy (Docker sets this to http://backend:${BACKEND_PORT})
BACKEND_URL=http://localhost:5000

# Port the frontend dev server listens on (default: 3000)
FRONTEND_PORT=3000

# Comma-separated hostnames Vite will accept requests from.
# Use "all" to allow any hostname (handy behind a reverse proxy).
# Example: ALLOWED_HOSTS=app-hunt.mc-schools.app,localhost
ALLOWED_HOSTS=localhost
